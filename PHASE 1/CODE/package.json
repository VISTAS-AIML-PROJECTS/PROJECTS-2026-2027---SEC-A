{
  "name": "purebreath-ai",
  "version": "1.0.0",
  "description": "PureBreath-AI — Personalized AQI Forecasting with Explainable AI",
  "private": true,
  "scripts": {
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn src.api:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:full": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "pip install -r requirements.txt",
    "install:all": "npm run install:frontend && pip install -r requirements.txt",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}